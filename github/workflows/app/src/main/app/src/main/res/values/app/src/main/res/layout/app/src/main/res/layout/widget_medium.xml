<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
<ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/bg"/>
<View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#AD000000"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="8dp">
<TextView android:id="@+id/dateText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DECEMBER 17, 2026" android:textColor="#FFFFFF" android:textSize="9sp" android:letterSpacing="0.25" android:fontFamily="monospace" android:textStyle="bold"/>
<TextView android:id="@+id/countdownText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="47 DAYS : 12 HOURS : 22 MINS : 14 SEC" android:textColor="#FFFFFF" android:textSize="11sp" android:fontFamily="monospace" android:textStyle="bold" android:singleLine="true" android:layout_marginTop="4dp"/>
<TextView android:id="@+id/untilText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UNTIL DOOMSDAY" android:textColor="#FFFFFF" android:textSize="7sp" android:fontFamily="monospace" android:letterSpacing="0.3" android:layout_marginTop="4dp"/>
</LinearLayout>
</FrameLayout>
